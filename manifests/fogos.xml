<?xml version="1.0" encoding="UTF-8"?>
<!-- VirgoX-Elite-GamingOS-Rom - Motorola Moto G45 5G / G34 5G (fogos) -->
<!-- Maintainer: VIRGOYT707 -->
<manifest>
  <remote name="github" fetch="https://github.com/" />

  <!-- Audited fogos device tree and shared SM6375 platform. -->
  <project name="darkvirgoyt-beep/android17_device_motorola_fogos" path="device/motorola/fogos" remote="github" revision="main" />
  <project name="darkvirgoyt-beep/android_device_motorola_sm6375-common" path="device/motorola/sm6375-common" remote="github" revision="lineage-23.2" />

  <!-- Vendor blobs must come from the matching Motorola firmware and Android base. -->
  <!-- Keep proprietary vendor projects out of this manifest until their revision is confirmed. -->

  <!-- Audited gaming kernel source. -->
  <project name="darkvirgoyt-beep/android_kernel_motorola_fogos" path="kernel/motorola/fogos" remote="github" revision="sixteen-qpr2" />

  <!-- Connected FogOS Controller source/reference. -->
  <project name="darkvirgoyt-beep/FogOS-PulseControl" path="vendor/virgox/FogOS-PulseControl" remote="github" revision="main" />

  <!-- Hardware HAL modules must match the selected ROM base. -->
  <project name="LineageOS/android_hardware_motorola" path="hardware/motorola" remote="github" revision="lineage-23.2" />

  <!-- Gaming profiles are provided by FogOS PulseControl; unrelated GameSpace and Dolby projects are intentionally excluded. -->
</manifest>
