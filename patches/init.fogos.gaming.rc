# ==============================================================================
# FogOS Elite Gaming Kernel & Low-Level Tuning - Moto G45 (fogos / SM6375)
# Developer : Prince · VirgoYT (VirgoYT707)
# ==============================================================================

on early-init
    # Set I/O schedulers to bfq / mq-deadline for rapid game asset streaming
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sda/queue/read_ahead_kb 512
    write /sys/block/sdb/queue/read_ahead_kb 512
    write /sys/block/sda/queue/nr_requests 256
    write /sys/block/sda/queue/iostats 0

on init
    # Sched-boost for top-app and foreground cgroups
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-5,7
    write /dev/stune/top-app/schedtune.boost 30
    write /dev/stune/top-app/schedtune.prefer_idle 1
    write /dev/stune/foreground/schedtune.boost 10

    # Minimum task util boost thresholds for fast thread placement
    write /proc/sys/kernel/sched_min_task_util_for_boost 51
    write /proc/sys/kernel/sched_min_task_util_for_colocation 35

on boot
    # --------------------------------------------------------------------------
    # 1. CPU / GPU Frequency & Governor Boost (SM6375 / Holi)
    # --------------------------------------------------------------------------
    # CPU Input Boost (40ms - 60ms boost on touch events)
    write /sys/devices/system/cpu/cpu_boost/input_boost_freq "0:1200000 6:1800000"
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 60

    # Schedutil Transition Tuning (0.5ms ramp-up, 20ms hold)
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load 85

    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load 85

    # Adreno 619 GPU Tunings
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor msm-adreno-tz
    write /sys/class/kgsl/kgsl-3d0/force_bus_on 1
    write /sys/class/kgsl/kgsl-3d0/force_clk_on 1
    write /sys/class/kgsl/kgsl-3d0/idle_timer 64
    write /sys/class/kgsl/kgsl-3d0/throttling 0

    # --------------------------------------------------------------------------
    # 2. Input / Touch / Latency Delay (LAY_MS = 5 or lower) & DT2W
    # --------------------------------------------------------------------------
    write /sys/android_touch/double_tap_enable 1
    write /sys/devices/virtual/touch/touch_dev/double_tap 1
    write /sys/devices/virtual/touch/touch_dev/game_mode 1
    write /sys/devices/virtual/touch/touch_dev/touch_delay_ms 5

    # --------------------------------------------------------------------------
    # 3. Memory & Virtual Memory (zRAM, Swappiness, MGLRU)
    # --------------------------------------------------------------------------
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 70
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5

    # Multi-Gen LRU (MGLRU) enablement
    write /sys/kernel/mm/lru_gen/enabled 7
    write /sys/kernel/mm/lru_gen/min_ttl_ms 1000

    # --------------------------------------------------------------------------
    # 4. Network: TCP BBR / BBR2 & Ultra-Low Ping 26MB Socket Buffers
    # --------------------------------------------------------------------------
    # Buffer sizes for zero packet drops and lowest ping
    write /proc/sys/net/core/rmem_max 26214400
    write /proc/sys/net/core/wmem_max 26214400
    write /proc/sys/net/core/default_qdisc fq
    write /proc/sys/net/ipv4/tcp_rmem "4096 87380 134217728"
    write /proc/sys/net/ipv4/tcp_wmem "4096 65536 134217728"
    write /proc/sys/net/ipv4/tcp_low_latency 1
    write /proc/sys/net/ipv4/tcp_fastopen 3

    # Enable BBR2 with fallback to BBR
    write /proc/sys/net/ipv4/tcp_congestion_control bbr2
    write /proc/sys/net/ipv4/tcp_congestion_control bbr

    # Goodix GT917S Touchscreen DT2W & Wake Gestures
    chmod 0660 /sys/devices/platform/goodix_ts.0/double_tap
    chown system system /sys/devices/platform/goodix_ts.0/double_tap
    write /sys/devices/platform/goodix_ts.0/double_tap 1

    chmod 0660 /sys/class/touchscreen/primary/wake_gestures
    chown system system /sys/class/touchscreen/primary/wake_gestures
    write /sys/class/touchscreen/primary/wake_gestures 1

    # IMU / Gyroscope Low-Latency Polling (SENSOR_RATE_FASTEST)
    write /sys/devices/platform/soc/soc:sensors/batch_delay 0
    write /sys/class/sensors/gyro_sensor/poll_delay 5
    write /sys/class/sensors/accelerometer_sensor/poll_delay 5

# ==============================================================================
# Dynamic Performance Profiles (Quick Settings Tiles & FogOS PulseControl)
# ==============================================================================
on property:persist.fogos.profile=powersave
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1500000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 1800000
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 450000000
    write /proc/sys/vm/swappiness 60
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 20
    exec_background - root root -- /system/bin/fogos_game_network.sh 0

on property:persist.fogos.profile=balanced
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2208000
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 840000000
    write /proc/sys/vm/swappiness 100
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 40
    exec_background - root root -- /system/bin/fogos_game_network.sh 0

on property:persist.fogos.profile=gaming
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2000000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2208000
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 950000000
    write /sys/class/kgsl/kgsl-3d0/force_bus_on 1
    write /sys/class/kgsl/kgsl-3d0/force_clk_on 1
    write /sys/class/kgsl/kgsl-3d0/throttling 0
    write /proc/sys/vm/swappiness 100
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 60
    exec_background - root root -- /system/bin/fogos_game_network.sh 1

on property:persist.fogos.profile=turbo
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2000000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2208000
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 950000000
    write /sys/class/kgsl/kgsl-3d0/force_bus_on 1
    write /sys/class/kgsl/kgsl-3d0/force_clk_on 1
    write /sys/class/kgsl/kgsl-3d0/throttling 0
    write /proc/sys/vm/swappiness 100
    write /sys/devices/system/cpu/cpu_boost/input_boost_ms 80
    exec_background - root root -- /system/bin/fogos_game_network.sh 1

# Performance mode toggle hook
on property:sys.perf.mode=1
    setprop persist.fogos.profile turbo

on property:sys.perf.mode=0
    setprop persist.fogos.profile balanced

# --- GAMING SYSCTL & KERNEL GRANULARITY TWEAKS ---
on boot
    write /proc/sys/net/core/somaxconn 1024
    write /proc/sys/vm/vfs_cache_pressure 50
    write /proc/sys/kernel/sched_min_granularity_ns 1000000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 3000000
