<manifest>
  <remote name="github" fetch="https://github.com/" />
  <remote name="virgox" fetch="https://github.com/darkvirgoyt-beep/" />

  <!-- ═══ Device Trees (Android 17) ═══ -->
  <project name="android17_device_motorola_fogos"
           path="device/motorola/fogos"
           remote="virgox"
           revision="main" />

  <project name="android_device_motorola_sm6375-common"
           path="device/motorola/sm6375-common"
           remote="virgox"
           revision="lineage-23.2" />

  <!-- ═══ Kernel (Gaming Kernel — Android 17 compatible) ═══ -->
  <project name="android_kernel_motorola_fogos"
           path="kernel/motorola/fogos"
           remote="virgox"
           revision="seventeen" />

  <!-- ═══ Vendor Blobs ═══ -->
  <!-- TODO: Uncomment and set correct revision once vendor blobs are extracted
       from matching Android 17 Motorola stock firmware.
  <project name="TheMuppets/proprietary_vendor_motorola_fogos"
           path="vendor/motorola/fogos"
           remote="github"
           revision="lineage-23.2" />
  <project name="TheMuppets/proprietary_vendor_motorola_sm6375-common"
           path="vendor/motorola/sm6375-common"
           remote="github"
           revision="lineage-23.2" />
  -->

  <!-- ═══ VirgoX Custom Layer ═══ -->
  <project name="FogOS-PulseControl"
           path="vendor/virgox/FogOS-PulseControl"
           remote="virgox"
           revision="main" />

  <!-- ═══ Hardware HALs (Android 17 era) ═══ -->
  <project name="LineageOS/android_hardware_motorola"
           path="hardware/motorola"
           remote="github"
           revision="lineage-23.2" />

  <!-- Gaming profiles provided by FogOS PulseControl.
       Unrelated GameSpace and Dolby projects are intentionally excluded. -->
</manifest>
