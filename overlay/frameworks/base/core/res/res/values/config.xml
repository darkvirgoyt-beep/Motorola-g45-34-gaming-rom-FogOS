<?xml version="1.0" encoding="utf-8"?>
<!-- FogOS Elite Gaming Framework Overlays -->
<!-- Developer: Prince · VirgoYT -->
<resources>
    <!-- Force Game Mode Interventions & GameManagerService -->
    <bool name="config_gameManagerSupported">true</bool>

    <!-- Force 120Hz Maximum and Minimum Refresh Rates -->
    <integer name="config_defaultRefreshRate">120</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- Double-Tap to Wake Native Support -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Enable Dynamic High-Performance Mode -->
    <bool name="config_enablePerfMode">true</bool>

    <!-- Fast touch feedback and minimum touch latency -->
    <integer name="config_touchLatencyDelay">5</integer>
</resources>
