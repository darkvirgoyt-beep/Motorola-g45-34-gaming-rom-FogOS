# ==============================================================================
# VirgoX Elite Gaming OS Properties - Motorola Moto G45 5G / G34 5G (fogos)
# Developer : Prince · VirgoYT (VirgoYT707)
# Description: This file defines custom system properties that are set during 
#              build time to configure performance, display, and gaming optimizations.
# ==============================================================================

# --- BRANDING & CREDITS ---
ro.build.display.id=VirgoX-Elite-Gaming-OS-v1.0
ro.virgox.version=1.0-EliteGaming
ro.virgox.base=LineageOS
ro.virgox.target.android=17
ro.virgox.ram.support=4GB-8GB-Unified
ro.virgox.maintainer=Prince · VirgoYT
ro.build.user=VirgoYT
ro.build.host=VirgoYT-Gaming-Lab
persist.sys.custom.maintainer=VirgoYT
ro.modversion=VirgoX-v1.0-fogos-VirgoYT

# --- CPU, SCHEDULER & THREAD BOOST ---
sched.colocate.enable=1
ro.vendor.qti.sys.perf.tuning=1
persist.sys.game_mode=1
ro.vendor.extension_library=libqti-perfd-client.so

# --- DISPLAY, 120HZ LOCK & TOUCH LATENCY (LAY_MS = 5) ---
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.set_idle_timer_ms=0
ro.surface_flinger.set_touch_timer_ms=5
ro.surface_flinger.set_display_power_timer_ms=0
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.supports_background_blur=0
ro.vendor.display.perf_mode=1
debug.sf.latch_unsignaled=1

# Android Frame Pacing (Swappy) & VK_EXT_present_timing
ro.sf.present_timing=1
debug.vulkan.enable_present_timing=1
ro.vendor.display.frame_pacing=1
debug.sf.frame_rate_multiple_threshold=60

# --- TOUCH SAMPLING (1000Hz ESPORTS ENGINE), ZERO LATENCY & DOUBLE-TAP-TO-WAKE ---
windowsmgr.max_events_per_sec=1000
persist.sys.touch.sampling_rate=1000
persist.vendor.touch.sampling_rate=1000
persist.vendor.touch.rate=1000
persist.sys.touch.rate=1000
ro.vendor.touch.polling_rate=1000
ro.input.sampling_rate=1000
touch.sampling_rate=1000
touch.pressure.scale=0.001
persist.sys.touch.esports=1
persist.sys.touch.latency_tuning=1
persist.sys.touch.debounce_ms=0
persist.sys.touch.delay_ms=0
persist.sys.touch_delay_ms=0
ro.surface_flinger.set_touch_timer_ms=0
ro.vendor.touch.dt2w=1

# --- ADRENO 619 GPU BOOST & RENDERING PIPELINE ---
debug.sf.disable_backpressure=1
debug.sf.enable_gl_backpressure=0
debug.cpurend.vsync=false
debug.hwui.render_dirty_regions=false
debug.renderengine.backend=skiagl
debug.egl.hw=1
debug.sf.hw=1
debug.hwui.use_buffer_age=true

# --- MEMORY, LMKD & ZRAM TUNING ---
ro.vendor.qti.config.zram=true
persist.sys.zram_enabled=1
ro.zram.mark_idle_delay_mins=60
ro.sys.fw.bg_apps_limit=32

# LMKD (LowMemoryKiller Daemon) Tuning
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.use_psi=true
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=80
ro.lmk.swap_free_low_percentage=10
ro.lmk.critical_upgrade=false

# --- THERMAL MITIGATION OVERRIDE ---
persist.vendor.power.thermal_mitigation=0
persist.sys.thermal.mitigation=0
vendor.thermal.governor.tuning=gaming

# --- NETWORK: TCP BBR2 & 26MB BUFFER SIZES FOR LOW PING ---
net.core.rmem_max=26214400
net.core.wmem_max=26214400
net.ipv4.tcp_rmem=4096 87380 134217728
net.ipv4.tcp_wmem=4096 65536 134217728
net.ipv4.tcp_congestion_control=bbr2
net.tcp.default_init_rwnd=60
net.ipv4.tcp_low_latency=1

# --- GOOGLE PLAY INTEGRITY & BANKING APPS SPOOFING ---
ro.build.type=user
ro.build.tags=release-keys
ro.debuggable=0
ro.secure=1
ro.adb.secure=1
ro.warranty_bit=0

# --- DISABLE BLOAT LOGGING, STATSD & TRACING ---
debug.atrace.tags.enableflags=0
persist.traced.enable=0
logcat.live=disable
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1
ro.config.nocheckin=1
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0

# --- SYSTEM_EXT & GAMING DISPLAY ENGINE ---
ro.sf.lcd_density=320
ro.sf.hwc.disable_metadata_buffer=true
debug.sf.disable_triple_frame_buffer=1
debug.sf.enable_hwc_vds=1
debug.sf.force_hwc_copy=false

# --- INPUT / 1000Hz TOUCH SAMPLING & AIM SENSITIVITY ---
ro.input.max_events=2000
ro.input.event_per_port=128
debug.touch.slop_scale=0.25
debug.touch.sensitivity=2

# --- GAMING ENGINE & THERMAL CAP ---
ro.game_maxtemp.enable=true
ro.game.overlay=true
ro.sf.game_mode_opt=true
debug.game.optimization=true
debug.sf.game_rendering_optimization=true

# --- INPUT LATENCY REDUCTION & TOUCH FRAME PREDICTION ---
debug.input.latency=0
debug.sf.touch_frame_prediction=1
ro.sf.frame_prediction=true

# --- iOS-GRADE GYROSCOPE CALIBRATION & DIRECT CHANNEL HARDWARE POLLING ---
ro.sensor.gyro.cal=true
ro.sensor.game_gesture=true
ro.sensor.rate.fastest=1000
persist.vendor.sensors.direct_channel=true
persist.vendor.sensors.support_direct_channel=true
persist.vendor.sensors.enable.rt_task=true
persist.vendor.sensors.enable.bypass_worker=true
persist.vendor.sensors.enable.mag_filter=false
persist.vendor.sensors.batch_delay=0
persist.vendor.sensors.hal.imu_filter=0
ro.vendor.sensors.ssc=true
ro.vendor.sensors.adsp=true
persist.fogos.gyro.smoothing=0
persist.fogos.gyro.sensitivity=1.0
persist.sys.gyro.ios_mode=1

# --- GOODIX GT917S TOUCHSCREEN & WAKE GESTURES ---
persist.vendor.touch.gt917s.enable=1
persist.vendor.touchscreen.wake_gestures=1
persist.vendor.touch.double_tap=1

# --- DOLBY ATMOS, SPATIAL AUDIO & MOTODOLBY / DIRAC ---
ro.vendor.audio.dolby=true
ro.vendor.audio.surround=true
ro.vendor.audio.spatial=true
persist.vendor.audio.spatializer.enabled=true
persist.vendor.audio.dolby.ds1.enabled=true
ro.vendor.audio.motodolby=true
ro.vendor.audio.dirac=true

# --- WIFI 6E ENABLEMENT FOR FOGOS ---
persist.vendor.wifi.6e=true
ro.vendor.wifi.sap.interface=wlan0
persist.vendor.wifi.softap.wpa3=1

# --- VOLTE / VOWIFI / VILTE ENABLED BY DEFAULT ---
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.radio.volte_is_avail=1
persist.vendor.radio.vt_is_avail=1
persist.vendor.radio.wfc_is_avail=1

# --- CAMERA2 API (HAL3) & MOTO CAMERA PORT ---
persist.vendor.camera.HAL3.enabled=1
vendor.camera.aux.packagelist=com.motorola.camera3,com.google.android.GoogleCamera
ro.vendor.camera.mot_hal3=1

# --- VULKAN VK_EXT_PRESENT_TIMING & GAMEMANAGERSERVICE INTERVENTIONS ---
debug.sf.enable_present_timing=1
debug.vulkan.present_timing=1
ro.vendor.display.enable_vk_present_timing=1
