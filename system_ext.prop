# ==============================================================================
# VirgoX Elite Gaming OS system_ext Properties - Motorola Moto G45 (fogos)
# Developer : Prince · VirgoYT (VirgoYT707)
# ==============================================================================

# --- PERFORMANCE ---
ro.sf.lcd_density=320
ro.sf.hwc.disable_metadata_buffer=true
debug.sf.hw=1
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1
debug.sf.disable_triple_frame_buffer=1
debug.sf.enable_hwc_vds=1
debug.sf.force_hwc_copy=false

# --- INPUT / 1000Hz ESPORTS TOUCH SAMPLING ---
windowsmgr.max_events_per_sec=1000
ro.input.sampling_rate=1000
persist.sys.touch.sampling_rate=1000
persist.vendor.touch.sampling_rate=1000
persist.vendor.touch.rate=1000
persist.sys.touch.rate=1000
ro.vendor.touch.polling_rate=1000
touch.sampling_rate=1000
ro.input.max_events=2000
ro.input.event_per_port=128
persist.sys.touch.esports=1
persist.sys.touch.debounce_ms=0
persist.sys.touch_delay_ms=0
persist.sys.touch.delay_ms=0
ro.surface_flinger.set_touch_timer_ms=0
debug.touch.slop_scale=0.25
debug.touch.sensitivity=2

# --- GAMING (Valid Android Properties) ---

# --- INPUT LATENCY & TOUCH PREDICTION ---
debug.input.latency=0
debug.sf.touch_frame_prediction=1
ro.sf.frame_prediction=true

# --- iOS-GRADE GYROSCOPE CALIBRATION & DIRECT CHANNEL HARDWARE POLLING ---
ro.sensor.gyro.cal=true
ro.sensor.game_gesture=true
ro.sensor.rate.fastest=1000
persist.vendor.sensors.direct_channel=true
persist.vendor.sensors.support_direct_channel=true
persist.vendor.sensors.enable.rt_task=true
persist.vendor.sensors.enable.bypass_worker=true
persist.vendor.sensors.enable.mag_filter=false
persist.vendor.sensors.batch_delay=0
persist.vendor.sensors.hal.imu_filter=0
persist.fogos.gyro.smoothing=0
persist.fogos.gyro.sensitivity=1.0
persist.sys.gyro.ios_mode=1
ro.vendor.sensors.ssc=true
ro.vendor.sensors.adsp=true

# --- GOODIX GT917S TOUCHSCREEN DT2W ---
persist.vendor.touch.gt917s.enable=1
persist.vendor.touchscreen.wake_gestures=1
persist.vendor.touch.double_tap=1

# --- DOLBY ATMOS & SPATIAL AUDIO ---
ro.vendor.audio.dolby=true
ro.vendor.audio.surround=true
ro.vendor.audio.spatial=true
persist.vendor.audio.spatializer.enabled=true
persist.vendor.audio.dolby.ds1.enabled=true
ro.vendor.audio.motodolby=true

# --- CONNECTIVITY (WiFi 6E & VoLTE / VoWiFi) ---
persist.vendor.wifi.6e=true
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.radio.volte_is_avail=1
persist.vendor.radio.wfc_is_avail=1

# --- CAMERA2 API ---
persist.vendor.camera.HAL3.enabled=1
vendor.camera.aux.packagelist=com.motorola.camera3,com.google.android.GoogleCamera
ro.vendor.camera.mot_hal3=1

# --- VIRGOX OTA UPDATE SYSTEM ---
ro.virgox.version=1.0-Cyber
ro.virgox.device=fogos
ro.virgox.ota.url=https://raw.githubusercontent.com/darkvirgoyt-beep/VirgoX-ROM-Portal/main/public/ota_feed.json
lineage.updater.uri=https://raw.githubusercontent.com/darkvirgoyt-beep/VirgoX-ROM-Portal/main/public/ota_feed.json
